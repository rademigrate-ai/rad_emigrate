# Template only. No project or hosting resource has been provisioned by this file.
APP_ENV=staging
RAD_DEPLOYMENT_KIND=staging
# Owner must supply an isolated non-production project's exact 20-letter ref.
RAD_STAGING_PROJECT_REF=
# Canonical HTTPS API URL belonging to that same staging project.
SUPABASE_URL=
# Owner-selected HTTPS staging site origin, distinct from production.
RAD_STAGING_SITE_URL=
# Use exactly one public key. Never put backend/provider credentials here.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=
